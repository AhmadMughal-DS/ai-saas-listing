SOCIAL_LINKEDIN=https://www.linkedin.com/company/145275481/
SOCIAL_YOUTUBE=https://www.youtube.com/@toolverai
SOCIAL_TIKTOK=https://www.tiktok.com/@toolverai
SOCIAL_INSTAGRAM=https://www.instagram.com/toolverai/
SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61594866789975
YOUTUBE_CHANNEL_ID=UCYvJzzh0J06KH4x9dLvYKXQ

# ─── Google Sheet ("Present Data in Website") ───────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=D:/company page/scrapedatafromtoolify/theta-anchor-454217-k2-95fba9368947.json
SPREADSHEET_ID=15mlK2uLnbw1J_LxQtisZuI0SxU50F8hHiIqCtDaCzBU
SHEET_TAB=🚀 Live Website Tools (120)

# ─── Existing contact source (MongoDB sponsorship_leads.emails) ─────────────
# Leave empty to read MONGODB_URI / MONGODB_DB_NAME from the project root .env
MONGODB_URI=
MONGODB_DB_NAME=toolver_db

# ─── Sending safety ──────────────────────────────────────────────────────────
DAILY_SEND_LIMIT=15
MIN_DELAY_SECONDS=300
MAX_DELAY_SECONDS=360
FOLLOWUP_AFTER_BUSINESS_DAYS=3
# Run SMTP RCPT probes against target mail servers (needs outbound port 25)
SMTP_PROBE=true
# Allow role-address guesses that could NOT be verified, incl. catch-all domains (higher bounce risk)
ALLOW_UNVERIFIED_FALLBACK=false
# Optional ZeroBounce API key — verifies emails over HTTPS (works even if port 25 is blocked),
# detects undeliverable/catch-all addresses before sending => near-zero bounces. Leave blank to
# use the built-in SMTP RCPT probe. Free tier: https://www.zerobounce.net/
EMAIL_VERIFY_API_KEY=
# Comma-separated domains never to contact (big-tech / no-sponsorship targets)
EXCLUDE_DOMAINS=google.com,microsoft.com,openai.com,chatgpt.com,adobe.com,apple.com,amazon.com,meta.com,github.com,x.ai,anthropic.com
# Minutes between inbox checks when running `python outreach.py run`
IMAP_POLL_MINUTES=5

