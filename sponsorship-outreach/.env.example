# ─── Sender mailbox (Namecheap Private Email) ────────────────────────────────
SENDER_EMAIL=partnership@toolverai.com
SENDER_NAME=ToolverAI Partnerships
SENDER_APP_PASSWORD=your-app-password-here
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993

# Optional physical mailing address for the email footer (recommended for CAN-SPAM)
SENDER_POSTAL_ADDRESS=

# ─── Website & socials ───────────────────────────────────────────────────────
