# ============================================================
# ToolverAI — Environment Variables Reference
# Copy to .env and fill in your actual values
# NEVER commit your actual .env file
# ============================================================

# ── App / Server ─────────────────────────────────────────────
PORT=3000
SITE_URL="https://toolverai.com"
CANONICAL_DOMAIN="https://toolverai.com"
NODE_ENV=production

# ── DeepSeek AI API ──────────────────────────────────────────
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# ── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="toolver_db"

# ── Firebase Admin SDK ───────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH="./ai-saas-listing-firebase-adminsdk-fbsvc-743174e1f9.json"
GOOGLE_APPLICATION_CREDENTIALS="./ai-saas-listing-firebase-adminsdk-fbsvc-743174e1f9.json"
FIREBASE_SERVICE_ACCOUNT=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="ai-saas-listing"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ── Admin Credentials ────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── SEO / Analytics ──────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=""

# Google Search Console site verification code (from HTML tag method)
VITE_GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools site verification code
VITE_BING_SITE_VERIFICATION=""

# ── IndexNow ─────────────────────────────────────────────────
# Generate a random UUID for IndexNow key: https://www.uuidgenerator.net/
INDEXNOW_KEY=""

# ── Social Media Profiles ────────────────────────────────────
VITE_SOCIAL_TWITTER="https://x.com/toolverai"
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_YOUTUBE=""
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_FACEBOOK=""

# ── SEO Branding ─────────────────────────────────────────────
VITE_OG_DEFAULT_IMAGE="https://toolverai.com/og-banner.png"
