# ============================================================
# ToolverAI — Environment Variables Reference
# Copy to .env and fill in your actual values
# NEVER commit your actual .env file to version control
# ============================================================

# ── App / Server ─────────────────────────────────────────────
PORT=3000
SITE_URL="https://toolverai.com"
CANONICAL_DOMAIN="https://toolverai.com"
NODE_ENV=production

# ── DeepSeek AI API ──────────────────────────────────────────
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# ── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="toolver_db"

# ── Firebase Admin SDK ───────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH="./ai-saas-listing-firebase-adminsdk-fbsvc-743174e1f9.json"
GOOGLE_APPLICATION_CREDENTIALS="./ai-saas-listing-firebase-adminsdk-fbsvc-743174e1f9.json"
FIREBASE_SERVICE_ACCOUNT=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="ai-saas-listing"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ── Admin Credentials ────────────────────────────────────────
# IMPORTANT: Change these from defaults before deploying to production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── SEO / Analytics ──────────────────────────────────────────

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Get from: https://analytics.google.com/
VITE_GA4_MEASUREMENT_ID=""

# Google Search Console site verification token
# Get from: Search Console > Settings > Ownership Verification > HTML Tag method
# Copy only the content attribute value, e.g. "abc123XYZ..."
VITE_GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools site verification token
# Get from: https://www.bing.com/webmasters/ > Add Site > XML file method or Meta tag
# Copy only the content attribute value
VITE_BING_SITE_VERIFICATION=""

# ── IndexNow ─────────────────────────────────────────────────
# IndexNow is used to instantly notify Bing (and other engines) of new/updated pages
# Generate a random UUID: https://www.uuidgenerator.net/
# Then register at: https://www.bing.com/indexnow
INDEXNOW_KEY=""

# ── Social Media Profiles ────────────────────────────────────
# Only configure profiles that are active — unset variables won't show in footer
VITE_SOCIAL_TWITTER="https://x.com/toolverai"
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_YOUTUBE=""
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_FACEBOOK=""
VITE_SOCIAL_TIKTOK=""

# ── SEO Branding ─────────────────────────────────────────────
# OG image URL used as fallback for social sharing (1200x630px recommended)
VITE_OG_DEFAULT_IMAGE="https://toolverai.com/og-banner.png"
