# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls.
# Get your API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_PUBLIC_KEY: Public key for Stripe checkout and subscription management
VITE_STRIPE_PUBLIC_KEY=

# MONGODB_URI: Connection string for persistent MongoDB storage
MONGODB_URI=

# FIREBASE_CONFIG: Firebase real-time auth client configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

